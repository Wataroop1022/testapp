# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# サーバー専用。NEXT_PUBLIC_ を付けない・クライアントに絶対公開しない
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI自動更新フィード用(app/api/cron/update-feed と scripts/update-party-feed.mjs が使用)。
# Vercelにも本番用の値を設定すること。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Cronからの呼び出しを検証するための合言葉。ランダムな16文字以上の文字列を
# 自分で生成してVercelの環境変数にも同じ値を設定する(Vercelが自動でAuthorizationヘッダーに載せてくれる)。
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ローカルで scripts/update-party-feed.mjs を手動実行する時だけ使う(Vercel上ではNEXT_PUBLIC_SUPABASE_URLで代用される)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
